{
  "name": "char-cnt",
  "version": "0.0.1",
  "description": "文字数カウントは余計な機能は一切なし！とにかく文字数だけを正確にカウントしたい方におすすめです。SEO対策にも役立つ、シンプルで使いやすいツールです。",
  "productName": "文字数カウント",
  "author": "it-araiguma <notnow618@gmail.com>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "esbuild src/utils/genkoCount.test.ts --bundle --platform=node --format=esm --outfile=.quasar/genkoCount.test.mjs && node --test .quasar/genkoCount.test.mjs",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "postinstall": "quasar prepare",
    "typecheck": "quasar prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.2.1",
    "pinia": "^2.0.11",
    "quasar": "^2.35.6",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^2.6.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.10.3",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.1.1",
    "workbox-cacheable-response": "^7.1.0",
    "workbox-core": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  },
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
